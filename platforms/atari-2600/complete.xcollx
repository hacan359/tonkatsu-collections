      {
        "id": 24467,
        "name": "Pleiades",
        "summary": "In this multi-wave space shooter, enemy ships come at you in scrolling waves. Growing bird-like ships swoop down at the player's ship as more enemy ships spring forth from the mothership. During the final wave, the player must navigate around parked ships to hit landing pad right on.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/q9ieny182g72aup0th9f.jpg",
