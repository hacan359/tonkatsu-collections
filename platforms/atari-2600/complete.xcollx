      {
        "id": 40667,
        "name": "Gamma-Attack",
        "summary": "You are the commander of the only GAMMA ship in this stellar field. The Vegan war fleet has taken control of your GAMMA outpost planet and is defending it with Vegan laser pulse tanks. This planet is the only inhabitable planet in this star system, and you must stay there and fight the Vegans as long as you can.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/knavmr2wtai0s6ntnzfw.jpg",
