      {
        "id": 40617,
        "name": "Tank Brigade",
        "summary": "The object of this Combat-like game is to protect your base from the advancing enemy tanks. Drive around in your tank destroying the other tanks, as they come after you four at a time. The game ends when you run out of tanks or your base is destroyed.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co797a.jpg",
