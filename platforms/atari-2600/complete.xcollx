      },
      {
        "id": 320413,
        "name": "Em Busca dos Tesouros",
        "summary": "In command of the adventurer H. Unter Kid, the player must explore the terrible T. Nebrous Land in search of incredible treasures, but not before facing unique and hostile creatures, such as the Crazy Scorpion and the Big Head Kannibal!\n\nPitfall! heavily inspired this game, initially released for the ZX81 line of computers, but is now available on the Atari 2600!",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co8yvo.jpg",
