      {
        "id": 40607,
        "name": "Poker Squares",
        "summary": "In Poker Squares your goal is to place 25 playing cards (from a deck of 52), one at a time, in a 5x5 grid. Your goal is to make the best ten (or twelve) poker hands, five horizontally, five vertically, and optionally the two diagonals, scoring as many points as possible.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co5yn6.jpg",
        "release_date": 1107216000,
        "rating": null,
