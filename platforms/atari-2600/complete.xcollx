      },
      {
        "id": 40666,
        "name": "3D Ghost Attack!",
        "summary": "Originally planned as a pack-in cassette title for Amiga's never released Power Module peripheral, and later as one of three 3-D games on the first Power Play Arcade cart. 3 different prototypes exist, each being a different level of the game. Unfortunately, none of the prototypes are 100% complete, but two are playable. The game uses the traditional red/blue anaglyph glasses.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co1scb.jpg",
