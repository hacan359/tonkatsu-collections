  "media": {
    "games": [
      {
        "id": 236,
        "name": "Myst",
        "summary": "A mystical journey through worlds that changed the concept of an adventure game.\n\nLose yourself in fantastic virtual exploration, blurring the line between fantasy and reality, challenging your wits, instincts, and powers of observation like never before. The fantasy beckons... can you resist its call?",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co1y96.jpg",
        "release_date": 748828800,
        "rating": 75.7321894721202,
        "rating_count": 181,
        "genres": "Point-and-click|Puzzle|Adventure",
        "platform_ids": "405,59,117,9,74,6,50,14,487,16,410,46,32,7,38",
        "external_url": "https://www.igdb.com/games/myst",
        "cached_at": 1772527938
      },
      {
        "id": 1630,
        "name": "James Bond 007",
        "summary": "When it comes to fast-paced action and intrigue, nobody does it better than Bond. James Bond.\nBut you can try when you reenact scenes from four great James Bond movie classics.\n007's specially designed vehicle will take you on the ride of your life--over land, in the air, and under the sea! Through it all you must avoid obstacles, avert enemies, and accomplish four different missions!",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co2y9i.jpg",
        "release_date": 441676800,
        "rating": 49.03171790824834,
        "rating_count": 5,
        "genres": "Arcade",
        "platform_ids": "68,84,59,65,15,66",
        "external_url": "https://www.igdb.com/games/james-bond-007",
        "cached_at": 1772527938
      },
      {
        "id": 2218,
        "name": "Lilly Adventure",
        "summary": null,
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/of1vs2qo8xxhdavli6xh.jpg",
        "release_date": 441676800,
