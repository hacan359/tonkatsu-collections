      },
      {
        "id": 40660,
        "name": "Party Mix",
        "summary": "Call some friends and mix it up with five wild and crazy games: Bop a Buggy, Tug of War, Wizards' Keep, Down on the Line, and Handcar. Go head-to-head, or in teams of two. Compete against people, not a cold computer. Everyone plays at once.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co5ykr.jpg",
        "release_date": 412905600,
