        "cached_at": 1772527938
      },
      {
        "id": 40626,
        "name": "Cosmic Corridor",
        "summary": "Cosmic Corridor is similar to Atari's Vanguard, though it's graphically inferior. You control a ship that can fire in multiple directions. Fly through the tunnels in either direction shooting all of the bad guys.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co4l28.jpg",
        "release_date": 404956800,
        "rating": null,
