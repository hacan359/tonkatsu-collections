      },
      {
        "id": 25732,
        "name": "Pressure Cooker",
        "summary": "Business is booming at \"The Grille\". Hamburger orders are just pouring in. But back in the Assembly Room, the Food Dispenser is pouring out condiments everywhere. Help Short-Order Sam fill each order with the proper combination of tomatoes, onions, lettuce and cheese. And don't forget the bun! Then, rush the completed orders to the Wrapping Room fast. Alright cooks, grab your spatulas!",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/ts9bvuwnsqd86yib0txu.jpg",
        "release_date": 441676800,
        "rating": null,
