        "external_url": "https://www.igdb.com/games/batman-the-animated-series",
        "cached_at": 1778663170
      },
      {
        "id": 7774,
        "name": "Battle Pingpong",
        "summary": "Battle Ping-Pong is a Game Boy game revolving around ping-pong (or table\ntennis as it is generically called). One person on either side of a small table\nwith a net return a ball back and forth in a rally until the ball is either dead\nin play or bounces off the table.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/edim8ibmvnif4gmjmqhj.jpg",
