      {
        "id": 8301,
        "name": "Formula One 2003",
        "summary": "This game is an officially licensed product of the FIA Formula One 2003 championship. It features all the drivers, tracks (including changes), teams and the new qualifying rules and point tables. You can fine-tune almost every aspect of the chosen car to create the best setup for the current track.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co72et.jpg",
