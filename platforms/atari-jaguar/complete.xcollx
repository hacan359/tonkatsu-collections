      {
        "id": 4248,
        "name": "Dragon's Lair",
        "summary": "Haven't heard of Dragon's Lair?! Well, you play the heroic Dirk the Daring, a valiant knight on a quest to rescue the fair princess from the clutches of an evil dragon! Originally released in the summer of 1983, Dragon's Lair has solidified itself as a cultural icon in gaming.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co790c.jpg",
        "release_date": 424828800,
        "rating": 72.14812447546593,
        "rating_count": 44,
        "genres": "Adventure|Arcade",
        "platform_ids": "52,238,239,9,34,63,39,50,14,13,16,62,410,12,78",
        "external_url": "https://www.igdb.com/games/dragon-s-lair",
        "cached_at": 1772529801
      },
      {
        "id": 4271,
        "name": "Primal Rage",
        "summary": "A meteor struck the Earth, and caused great chaos. Seven gods from ancient times awoke, and are now attempting to take control of the post-apocalyptic world.\n\nPrimal Rage is a one-on-one fighting game featuring dinosaurs and giant apes as the fighters. The graphics are done with digitized stop-motion animation. Gameplay is similar to Mortal Kombat in that it is viewed from a side perspective, and features deadly finishing moves at the end of the match.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co309j.jpg",
        "release_date": 775699200,
        "rating": 61.02468325594474,
        "rating_count": 48,
