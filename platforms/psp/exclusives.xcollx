      {
        "id": 2994,
        "name": "Invizimals",
        "summary": "Invizimals is a PlayStation Portable augmented reality video game developed by Novarama, and published by Sony Computer Entertainment Europe. It is a collectible creature game, and is bundled with the PSP's camera attachment on launch.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co4mum.jpg",
