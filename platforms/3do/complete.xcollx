      },
      {
        "id": 20314,
        "name": "Off-World Interceptor Extreme",
        "summary": "Off-World Interceptor is a third-person vehicular car combat game, released only for the 3DO. An alternate version of the game was later released for the Sega Saturn and PlayStation consoles, named Off-World Interceptor Extreme. The two versions of the game have identical core gameplay elements, though the Extreme version is tweaked to feel more like the arcade mode in the original Off-World Interceptor.\n\nThe game was developed under the title \"Orion Off-Road\".",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co409f.jpg",
        "release_date": 815184000,
        "rating": null,
