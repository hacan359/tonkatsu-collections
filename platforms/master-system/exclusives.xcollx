      },
      {
        "id": 18145,
        "name": "Rambo III",
        "summary": "Rambo III is a shooting game developed and published by Sega for the Sega Master System, making use of the Light Phaser peripheral. It is based upon the film Rambo III.\n\nJohn Rambo, America's favorite soldier, makes a daring rescue attempt on a Russian military base deep in war-torn Afghanistan. A fast-shooting Light Phaser game that tests your fighting skills to the limit.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co4odh.jpg",
        "release_date": 596937600,
        "rating": 62.23929639599784,
        "rating_count": 8,
        "genres": "Shooter,Arcade",
        "platform_ids": "64",
        "external_url": "https://www.igdb.com/games/rambo-iii--1",
        "cached_at": 1778663174
      },
      {
        "id": 19486,
        "name": "Astérix",
        "summary": "The Romans have kidnapped Getafix, who is the only one that can brew the magic potion the Gauls need to stand against the Romans. Asterix and Obelix embark on a journey to free him. You can play as either Asterix or Obelix which play slightly differently (Obelix is slower, but can manipulate objects, Asterix moves faster).",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co3k58.jpg",
        "release_date": 691545600,
        "rating": 79.52856277487024,
        "rating_count": 20,
        "genres": "Platform,Adventure",
