        "external_url": "https://www.igdb.com/games/final-fantasy-origins",
        "cached_at": 1778663177
      },
      {
        "id": 420,
        "name": "Final Fantasy Chronicles",
        "summary": "Final Fantasy Chronicles is a compilation that includes Final Fantasy IV, and another Square production, Chrono Trigger, released for the Sony PlayStation. Both games were ports of titles originally released for the Super Nintendo Entertainment System.\n\nAlthough both games differ little from the original versions in terms of gameplay, graphics and sound, a number of additional bonus/extra sequences are included, including art galleries, bestiaries and full motion video cutscenes.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co205y.jpg",
        "release_date": 993772800,
        "rating": 82.7679336199259,
        "rating_count": 7,
