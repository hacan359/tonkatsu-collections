      {
        "id": 15698,
        "name": "Metroid Dread",
        "summary": "Join intergalactic bounty hunter Samus Aran in her first new 2D Metroid story in 19 years. Samus’ story continues after the events of the Metroid Fusion game when she descends upon planet ZDR to investigate a mysterious transmission sent to the Galactic Federation. The remote planet has become overrun by vicious alien lifeforms and chilling mechanical menaces. Samus is more agile and capable than ever, but can she overcome the inhuman threat stalking the depths of ZDR?",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/coba9g.jpg",
        "release_date": 1633564800,
        "rating": 84.77031087028259,
        "rating_count": 201,
        "genres": "Shooter,Platform,Adventure",
        "platform_ids": "130",
        "external_url": "https://www.igdb.com/games/metroid-dread",
        "cached_at": 1778663188
      },
      {
        "id": 20578,
        "name": "Touch Detective",
        "summary": "In Touch Detective you will become Mackenzie, a fledgling detective, and solve various mysteries in a \"Touch Adventure\"!",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co94qr.jpg",
        "release_date": 1161648000,
        "rating": 78.82149046793761,
        "rating_count": 8,
        "genres": "Point-and-click,Puzzle",
