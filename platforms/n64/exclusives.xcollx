    "games": [
      {
        "id": 1074,
        "name": "Super Mario 64",
        "summary": "Mario is super in a whole new way! Combining the finest 3-D graphics ever developed for a video game and an explosive soundtrack, Super Mario 64 becomes a new standard for video games. It's packed with bruising battles, daunting obstacle courses, and underwater adventures. Retrieve the Power Stars from their hidden locations and confront your arch-nemesis— Bowser, King of the Koopas!\n\n• Run freely in a grassy meadow, tip-toe through a gloomy dungeon, climb to the top of a mountain, or take a swim in the moat!\n• Leap headfirst into a watery painting and soon you'll be searching for the surface in an underwater realm!\n• On-the-fly, 3-D rendered gameplay delivers the action of ruthless enemy attacks from every angle!\n• Find the Caps that give Mario super powers and ponder the mysteries of the pyramid; you can even race Koopas for fabulous prizes!\n• With the Nintendo 64 Controller and its analog\nControl Stick, Mario can crawl, kick down obstacles, swim, do reverse flips, and even stick the landing on his backwards somersault!\n• Saved game information is stored for up to four players in memory.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co721v.jpg",
        "release_date": 835488000,
        "rating": 88.75203965614105,
        "rating_count": 2001,
        "genres": "Platform,Adventure",
        "platform_ids": "5,4,41",
        "external_url": "https://www.igdb.com/games/super-mario-64",
        "cached_at": 1778663175
      },
      {
        "id": 1130,
        "name": "Castlevania",
        "summary": "Take control of Reinhardt Schneider, a whip-toting Vampire Killer who has waited his whole life to meet his destiny, or Carrie Fernandez, a young girl with a strong magical presence who is mysteriously drawn to Dracula's evil Castlevania. It is their duty to seek out Castlevania and put an end to its residents' plans. What is your destiny?",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co5geb.jpg",
