        "cached_at": 1772529804
      },
      {
        "id": 26411,
        "name": "Akira",
        "summary": "Akira is a cancelled video game based off of the anime film and manga series of the same name. The game, published by THQ, was intended for release sometime in 1994 and was planned for multiple consoles, including the Super Nintendo, Sega Genesis, Sega CD, Game Boy and Game Gear.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co4tpc.jpg",
