        "external_url": "https://www.igdb.com/games/rainbow-islands-the-story-of-bubble-bobble-2",
        "cached_at": 1772527935
      },
      {
        "id": 4418,
        "name": "Truxton",
        "summary": "Truxton is a 1988 vertically scrolling, shoot 'em up arcade game developed by Toaplan, later ported to the Mega Drive (worldwide) and the PC Engine (Japan-only). Like many other scrolling shooters, the game is set in outer space, where the player takes control of a small spaceship across several planets. The game is played with an eight-way joystick and two buttons (a shot and a bomb button) through five large levels and their bosses (which then loop forever, at higher difficulties).",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co2vgc.jpg",
        "release_date": 591667200,
        "rating": 69.42893134988569,
        "rating_count": 12,
        "genres": "Shooter|Arcade",
        "platform_ids": "52,3,29,34,6,86,39,14",
        "external_url": "https://www.igdb.com/games/truxton",
        "cached_at": 1772527935
      },
      {
        "id": 4440,
        "name": "Super Volley Ball",
        "summary": "Super Volley Ball is an indoor volleyball game for one or two players. The single player mode offers two game options: normal game and World League. Choosing normal game pits the player against the computer in a single game. Choosing World League pits the player against all other teams available. A password save is available in this mode.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co7kxy.jpg",
        "release_date": 631065600,
        "rating": null,
        "rating_count": null,
