      },
      {
        "id": 277058,
        "name": "Kuso Ecstasy",
        "summary": "This hack is all about diving into the disassembly and memory map to create unique gimmicks. Every level is a single room that has vanilla mechanics except for one outrageous thing. It's meant to be fun and mischievous, but at times mind-bending and unforgiving. This old school style of hacking draws a lot conceptually from Game Genie codes and emulator cheats. It's inspired by joke hacks, kuso, and old Japanese hacks alike.\n\nAlso there's 65 exits.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co7dqb.jpg",
        "release_date": 1613952000,
        "rating": null,
        "rating_count": null,
        "genres": "Platform",
