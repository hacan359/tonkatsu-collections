      },
      {
        "id": 42581,
        "name": "Skyblazer",
        "summary": "Arianna, a young sorceress, has been kidnapped by Ashura. Sky has pledged his life to rescuing her. Sky must venture through many colorful stages and nice background effects. Skyblazer is a blend of side-scrolling fighting with magical skills. Locating potions to recover energy and gaining magic points to thrash the enemies becomes a major part of the gameplay. Sky can also stick to and climb vertically up walls.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co2xh6.jpg",
