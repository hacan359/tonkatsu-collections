      {
        "id": 8809,
        "name": "Al Unser Jr.'s Turbo Racing",
        "summary": "Al Unser Jr.'s Turbo Racing is a racing video game for the Nintendo Entertainment System console released in 1990. It is an adaptation of the 1989 Japanese-market Famicom game World Grand Prix - Pole to Finish, with the most notable changes being the addition of Unser as an in-game coach, the number of laps, sound and interface design. This game features a season mode and two time trial modes.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_small/co6ns1.jpg",
