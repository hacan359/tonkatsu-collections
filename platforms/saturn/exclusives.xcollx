        "cached_at": 1778663185
      },
      {
        "id": 19732,
        "name": "NHL All-Star Hockey",
        "summary": "NHL All-Star Hockey is a Sports game, developed by Gray Matter and published by Sega, which was released in 1995.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co2gp6.jpg",
