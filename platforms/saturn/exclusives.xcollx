    "games": [
      {
        "id": 1669,
        "name": "Panzer Dragoon II Zwei",
        "summary": "Panzer Dragoon II Zwei is an \"on-rails\" shoot 'em up game released exclusively for the Sega Saturn. It was the second Panzer Dragoon game released but it is a prequel of the series. It was developed by Team Andromeda, one of Sega's internal development studios.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co8ixu.jpg",
        "release_date": 827452800,
        "rating": 71.72586437481418,
        "rating_count": 18,
        "genres": "Shooter",
        "platform_ids": "32",
        "external_url": "https://www.igdb.com/games/panzer-dragoon-ii-zwei",
        "cached_at": 1778663185
      },
      {
        "id": 1671,
        "name": "Panzer Dragoon Saga",
        "summary": "Enter the world of Panzer Dragoon Saga and experience a game like no other: a fusion of classic Panzer action with the most technologically advanced RPG to come to Saturn. Board your morphing dragon and behold as the mysteries of the Panzer world unfurl across four massive CDs. The new \"rail free\" 3D engine lets you soar deeper into role-playing adventure than you ever before imagined. Your destiny awaits.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/cobalf.jpg",
        "release_date": 886032000,
        "rating": 80.977497526506,
        "rating_count": 26,
        "genres": "Role-playing (RPG)",
        "platform_ids": "32",
        "external_url": "https://www.igdb.com/games/panzer-dragoon-saga",
        "cached_at": 1778663185
      },
      {
        "id": 3801,
        "name": "Dungeon Master Nexus",
        "summary": "Dungeon Master Nexus is part of the Dungeon Master series, it is the first game in the series using a 3D graphics engine. The game features 15 levels.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co5s3t.jpg",
        "release_date": 890870400,
        "rating": null,
        "rating_count": null,
        "genres": "Puzzle,Role-playing (RPG)",
        "platform_ids": "32",
        "external_url": "https://www.igdb.com/games/dungeon-master-nexus",
        "cached_at": 1778663185
      },
      {
        "id": 4127,
        "name": "Grandia",
        "summary": "Grandia is a role-playing video game developed by Game Arts and published by Entertainment Software Publishing for the Sega Saturn console as the first game in their Grandia series. Initially released in Japan in 1997, the game was later ported to the PlayStation in 1999, with an English version of the game appearing on the platform in North America in the following September by Sony Computer Entertainment America, and later in Europe in March 2000 by Ubisoft. The game was produced by much of the same staff who worked on the company's previous role-playing endeavor, the Lunar series, including producer Yoichi Miyagi and music composer Noriyuki Iwadare.\n\nSince its release, Grandia has become notable for its combat mechanics, which have been carried over to future games within the franchise, and has spawned two spin-off titles – Grandia: Digital Museum and Grandia: Parallel Trippers – both released exclusively in Japan. In celebration of the announcement of renewing development on Grandia Online, which acts as a prequel to Grandia, the game was re-released on Sony's PlayStation Network platform in Japan as a downloadable title in April 2009 and in North America on February 25, 2010. It was re-released in Europe on November 10, 2010.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/coafk6.jpg",
        "release_date": 882403200,
        "rating": 76.02580691709007,
        "rating_count": 51,
        "genres": "Role-playing (RPG)",
        "platform_ids": "9,34,32,7,38",
        "external_url": "https://www.igdb.com/games/grandia",
        "cached_at": 1778663185
      },
      {
        "id": 10221,
        "name": "Shinobi Legions",
        "summary": "Shinobi Legions, known as Shinobi X in Europe and as Shin Shinobi Den in Japan, is fifth and final game in original Shinobi series. It was developed and published by Sega in 1995 for Sega Saturn.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co30ik.jpg",
        "release_date": 804470400,
        "rating": null,
        "rating_count": null,
        "genres": "Platform,Hack and slash/Beat 'em up",
        "platform_ids": "32",
        "external_url": "https://www.igdb.com/games/shinobi-legions",
        "cached_at": 1778663185
      },
      {
        "id": 15021,
        "name": "Albert Odyssey: Legend of Eldean",
        "summary": "Albert Odyssey: Legend of Eldean is a role-playing video game developed by Sunsoft for the Super Nintendo, but cancelled and ported to the Sega Saturn. It is the first Albert Odyssey title to be released in English, as well as the first to feature traditional turn-based role-playing elements as opposed to tactical, strategy-based gameplay. Legend of Eldean was created as a \"gaiden\", or sidestory to the original titles, and contains back story, characters, and plot that are independent from earlier games in the series. The North American version received generally favorable reviews, with the game's translation invoking mixed criticism both for its overly-humorous tone and departure from the original Japanese dialogue.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co3z93.jpg",
        "release_date": 839548800,
        "rating": 65.87371512481644,
        "rating_count": 8,
        "genres": "Role-playing (RPG)",
        "platform_ids": "32,58",
        "external_url": "https://www.igdb.com/games/albert-odyssey-legend-of-eldean",
        "cached_at": 1778663185
      },
      {
        "id": 18493,
        "name": "Nanatsu Kaze no Shima Monogatari",
        "summary": "Tales of the Seven Wind Islands is a fantasy adventure game exclusively for the SEGA Saturn by Enix.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co3001.jpg",
        "release_date": 880588800,
        "rating": null,
        "rating_count": null,
        "genres": "Adventure",
        "platform_ids": "32",
        "external_url": "https://www.igdb.com/games/nanatsu-kaze-no-shima-monogatari",
        "cached_at": 1778663185
      },
      {
        "id": 19417,
        "name": "Keio Flying Squadron 2",
        "summary": "Keio Flying Squadron 2 was released in 1996 for the Sega Saturn in Japan, Europe, and Australia. The second installment of the series continues the story of Rami's adventures as the Keeper of the Secret Treasure (a sphere passed down through generations of Rami's family). Rami races Dr. Pon and a new rival Himiko Yamatai for an ancient treasure that can be unlocked with six spheres. Two of the stages retain the shoot-'em-up style of the first game, but the lesser dragons can be obtained as bonuses only.\n\nMainly the stages consist of sidescroling platformer stages. These scroll from right to left on the Japanese version and left to right on all other versions. Several bonuses can be collected including three weapons (Rami can also bounce on the heads of enemies to defeat them):\nA large mallet, used only for hitting enemies\nAn umbrella, used to hit enemies, float and deflect overhead obstacles\nA bow, used to shoot arrows at enemies.\n\nBesides the platformer and shoot-'em-up stages, there is vertically scrolling special stages, an underwater stage and a rollercoaster stage, making the game a multi-genre platformer. Points spheres can be collected throughout the game. A reward system accessed from the main menu unlocked helpful hints and behind-the-scenes extras depending on the highest and lowest scores achieved through playing.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co3s8b.jpg",
        "release_date": 832291200,
        "rating": null,
        "rating_count": null,
        "genres": "Shooter,Platform,Adventure",
        "platform_ids": "32",
        "external_url": "https://www.igdb.com/games/keio-flying-squadron-2",
        "cached_at": 1778663185
      },
      {
        "id": 19666,
        "name": "Burning Rangers",
        "summary": "Sonic Team brings you the fire fighting heroes of the future... The Burning Rangers. In the life of a Burning Ranger, danger lurks around every corner, and you'll find there are many. Hazardous missions await you, the prime objective being to save the lives of helpless survivors. You will be assisted by an advanced voice navigation system, but the rest is up to you. You must think fast and act quickly if you are to save the day. Scorching graphics, intense gameplay, thrills without the kills... go for it!",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co3inj.jpg",
        "release_date": 890870400,
        "rating": 70.01745369921458,
        "rating_count": 5,
        "genres": "Shooter,Platform",
        "platform_ids": "32",
        "external_url": "https://www.igdb.com/games/burning-rangers",
        "cached_at": 1778663185
      },
      {
        "id": 19717,
        "name": "Clockwork Knight 2",
        "summary": "Clockwork Knight 2 uses identical gameplay to that of its predecessor, right down to using all the same items and having four rooms with three levels each, plus a final boss.\n\nHowever, there are three minor additions:\nFour playing cards are scattered around each level. Spinning all four cards gives players a Gold Key; collecting all 32 cards in the game yields a secret code.\nThere are some forced scrolling levels in which Pepper rides on the back of his steed Barobaro. Attacking is done not with Pepper's key in these levels, but by firing Barobaro's head at enemies.\nAn additional game mode called \"Bosses Galore\" lets the player control either Pepper or Ginger in fighting all the bosses of both Clockwork Knight games one after the other. Doing well in this mode is said to unlock a mini-game.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co5rrs.jpg",
        "release_date": 818985600,
        "rating": null,
        "rating_count": null,
        "genres": "Platform",
        "platform_ids": "32",
        "external_url": "https://www.igdb.com/games/clockwork-knight-2",
        "cached_at": 1778663185
      },
      {
        "id": 19720,
        "name": "Wing Arms",
        "summary": "Wing Arms is a blend of flight simulator and action game for the Sega Saturn, released in 1995. In an alternate history set after WWII, the player has to fight a multinational company which wants to prevent the war from ending.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co4aka.jpg",
        "release_date": 812332800,
        "rating": null,
        "rating_count": null,
        "genres": "Shooter,Simulator",
        "platform_ids": "32",
