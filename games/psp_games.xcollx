      {
        "id": 7471,
        "name": "Transformers: Revenge of the Fallen",
        "summary": "Transformers: Revenge of the Fallen is set a few years after the defeat of Megatron in the first game. The game is a linear third-person shooter that puts the player in control of many of the main characters from the movie, shifting between both Autobot and Decepticon factions.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_small/co2cy9.jpg",
        "release_date": 1245715200,
