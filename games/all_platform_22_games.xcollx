      {
        "id": 49933,
        "name": "Sesame Street: Elmo's ABCs",
        "summary": "Sesame Street: Elmo's ABCs is based on the 1980s computer game Letter-Go-Round. Instead of Sesame Street characters, such as Big Bird, Elmo finds a letter that goes merry-go-round to saying how the letters were. They solve by checking the controls to determine the letter.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_small/co4zca.jpg",
