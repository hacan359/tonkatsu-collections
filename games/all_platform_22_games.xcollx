      },
      {
        "id": 281543,
        "name": "Hamster Club 2",
        "summary": "The second hamster breeding simulation game. In addition to the familiar \"Shigecchi\", cute new characters are appearing one after another. A new mini-game has been added to the new story, and it is full of fun and cuteness. Comes with a mascot doll as a first-time limited benefit.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_small/co7kv4.jpg",
        "release_date": 976838400,
        "rating": null,
        "rating_count": null,
        "genres": "Simulator",
        "platform_ids": "22",
