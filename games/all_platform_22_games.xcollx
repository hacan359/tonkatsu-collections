      {
        "id": 675,
        "name": "Driver",
        "summary": "The player is John Tanner, an undercover cop who try to take advantage of his own excellent driving skill in order to infiltrate a criminal organization.\nIn the storyline, the player has the chance to drive several cars in four american cities (Miami, San Francisco, Los Angeles, and New York), facing many different missions and tasks such as delivering a vehicle without damaging it, eliminating competitors or being the getaway driver in a bank robbery.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_small/co6he0.jpg",
        "release_date": 930268800,
        "rating": 76.29270281491156,
        "rating_count": 221,
        "genres": "Racing|Simulator",
        "platform_ids": "22,9,6,39,14,7,38",
        "external_url": "https://www.igdb.com/games/driver",
        "cached_at": 1772527929
      },
      {
        "id": 969,
        "name": "Resident Evil Gaiden",
        "summary": "Resident Evil Gaiden is a Resident Evil game for the Game Boy Color. It is non-canon, as its plot is contradicted by the main series in key parts and its events are ignored. The game features three playable characters and consists of exploring areas, collecting items and combating enemies in the process. Unlike previous entries in the series, Resident Evil Gaiden assumes a top-down perspective for the environment portions that, upon approaching an enemy, changes to a first-person combat mode with a reticle constantly moving to the left and right. To attack, the player has to press the action button while the reticle is in range of the enemy.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_small/co2xix.jpg",
        "release_date": 990403200,
        "rating": 55.45133675034513,
        "rating_count": 25,
        "genres": "Adventure",
        "platform_ids": "22",
        "external_url": "https://www.igdb.com/games/resident-evil-gaiden",
        "cached_at": 1772527929
      },
      {
        "id": 1027,
        "name": "The Legend of Zelda: Link's Awakening DX",
        "summary": "The Legend of Zelda: Link's Awakening DX is an updated re-release of Link's Awakening with several new additions, the most notable of which being the entire game is now in color.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_small/co4o47.jpg",
        "release_date": 913420800,
        "rating": 88.54480672938747,
        "rating_count": 187,
        "genres": "Puzzle|Adventure",
        "platform_ids": "22,37",
        "external_url": "https://www.igdb.com/games/the-legend-of-zelda-link-s-awakening-dx",
        "cached_at": 1772527929
      },
      {
        "id": 1032,
        "name": "The Legend of Zelda: Oracle of Seasons",
        "summary": "The Legend of Zelda: Oracle of Seasons is one of two Zelda titles released for the Game Boy Color, the other being Oracle of Ages. The game retain many gameplay elements from Link's Awakening such as the graphics, audio and top-view perspective. It also features eight dungeons and a large overworld to explore like in the previous games. Oracle of Seasons is said to be more action-oriented than its counterpart being more puzzle-oriented. After completing one of the two games, both can be linked to form a single linear plot with an alternate ending. Oracle of Seasons and Oracle of Ages were often credited as being two of the top games for the Game Boy Color.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_small/co2tw0.jpg",
        "release_date": 983232000,
        "rating": 81.30250861336407,
        "rating_count": 189,
        "genres": "Puzzle|Role-playing (RPG)|Adventure",
        "platform_ids": "22,37",
        "external_url": "https://www.igdb.com/games/the-legend-of-zelda-oracle-of-seasons",
        "cached_at": 1772527929
      },
      {
        "id": 1041,
        "name": "The Legend of Zelda: Oracle of Ages",
        "summary": "The Legend of Zelda: Oracle of Ages is one of two Zelda titles released for the Game Boy Color, the other being Oracle of Seasons. The game retain many gameplay elements from Link's Awakening such as the graphics, audio and top-view perspective. It also features eight dungeons and a large overworld to explore like in the previous games. Oracle of Ages is said to be more puzzle-oriented than its counterpart being more action-oriented. After completing one of the two games, both can be linked to form a single linear plot with an alternate ending. Oracle of Ages and Oracle of Seasons were often credited as being two of the top games for the Game Boy Color.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_small/co2tw1.jpg",
        "release_date": 983232000,
        "rating": 84.26917663679875,
