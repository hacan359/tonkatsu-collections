        "id": 112659,
        "name": "Batman: Arkham Collection",
        "summary": "Batman: Arkham Collection includes the definitive versions of Rocksteady's Arkham Trilogy games, including all post-launch content, in one complete collection.\n\nBatman: Arkham Asylum and Batman: Arkham City have been remastered with updated visuals. The collection is completed by Batman: Arkham Knight.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co8wgm.jpg",
        "release_date": 1543276800,
        "rating": 99.60802340264476,
        "rating_count": 23,
        "genres": "Hack and slash/Beat 'em up|Adventure",
        "platform_ids": "48,6,49",
        "external_url": "https://www.igdb.com/games/batman-arkham-collection",
        "cached_at": 1772208576
      },
      {
        "id": 165192,
        "name": "The Elder Scrolls V: Skyrim - Anniversary Edition",
        "summary": "The Elder Scrolls V: Skyrim - Anniversary Edition contains the full game plus all three expansions and over 500 pieces of unique content from Creation Club, including pre-existing and new quests, dungeons, bosses, weapons, spells and more!",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/coa9tq.jpg",
