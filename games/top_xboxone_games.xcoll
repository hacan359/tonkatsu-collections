        "cached_at": 1772208576
      },
      {
        "id": 119402,
        "name": "The Witcher 3: Wild Hunt - Complete Edition",
        "summary": "The Witcher 3: Wild Hunt – Complete Edition is a comprehensive release that includes the base game, both major expansions (Hearts of Stone and Blood and Wine), and all free DLCs. It has been issued in multiple versions over time:\n\n- 2016 (PC, PS4, Xbox One): Released alongside the Game of the Year Edition, functionally identical but branded differently depending on region.\n\n- 2022 (PS5, Xbox Series X|S, PC): Updated version including the next-gen enhancements, such as ray tracing, visual upgrades, and quality-of-life improvements, plus additional content inspired by the Netflix series.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co5uct.jpg",
        "release_date": 1472428800,
        "rating": 96.71719162891915,
        "rating_count": 185,
        "genres": "Role-playing (RPG)|Adventure",
        "platform_ids": "169,48,6,167,49,130",
        "external_url": "https://www.igdb.com/games/the-witcher-3-wild-hunt-complete-edition--1",
