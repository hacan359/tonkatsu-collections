      {
        "id": 2201,
        "name": "The Duel: Test Drive II",
        "summary": "The Duel: Test Drive II is a cross-platform racing game developed by Distinctive Software and published by Accolade in 1989. It is the second entry in the Test Drive series of video games.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co7wom.jpg",
        "release_date": 631065600,
        "rating": 88.3263440091527,
