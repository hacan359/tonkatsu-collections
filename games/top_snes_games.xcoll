      {
        "id": 2899,
        "name": "EarthBound",
        "summary": "A turn-based JRPG and sequel to then-Japan-only Earthbound Beginnings (1989) in which Ness, a young boy living in a land based on the USA, leaves home to go on an adventure through strange locations, get to know quirky characters and defeat an unknowable alien threat called Giygas while facing up to the realities of growing up and becoming familiar with the real world.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co6v07.jpg",
        "release_date": 777945600,
        "rating": 89.2867953514137,
        "rating_count": 544,
