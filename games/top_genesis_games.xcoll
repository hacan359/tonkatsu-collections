      {
        "id": 1230,
        "name": "Phantasy Star IV: The End of the Millennium",
        "summary": "You are Chaz Ashely, a rookie Hunter straight out of training who is supported by Alys Brangwin – a crafty veteran whose good looks and prowess with the blade have earned her an awesome reputation. The two Hunters along with a cast of supporting characters will go beyond Motavia to unwittingly save their entire solar system.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co2g92.jpg",
        "release_date": 756086400,
        "rating": 88.25061161648044,
