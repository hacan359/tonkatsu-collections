        "cached_at": 1772208560
      },
      {
        "id": 16617,
        "name": "Super Mario World: Super Mario Advance 2",
        "summary": "Super Mario Advance 2: Super Mario World is a remake of Super Mario World for the Game Boy Advance starring Mario's dinosaur friend Yoshi for the first time.\n\nSuper Mario Advance is a four-part series for the GBA with Super Mario games of the NES and SNES era. The remakes came with adjusted graphics, sound and additional content. Each game of the series includes additionally the arcade-classic \"Mario Bros\" which can be played in multiplayer via link cable.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co6nhk.jpg",
        "release_date": 1008288000,
        "rating": 87.93160641752141,
        "rating_count": 73,
        "genres": "Platform|Adventure",
        "platform_ids": "41,24",
        "external_url": "https://www.igdb.com/games/super-mario-world-super-mario-advance-2",
        "cached_at": 1772208560
      },
