      {
        "id": 1240,
        "name": "Tekken Advance",
        "summary": "Tekken Advance is a fighting game released for the Game Boy Advance. It is non-canonical to the Tekken storyline, but follows the events of Tekken 3. It uses sprites based on Tekken 3's 3D models for its characters and was the first Tekken game to be released on a Nintendo platform.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_small/co45q0.jpg",
