        "cached_at": 1772208565
      },
      {
        "id": 4043,
        "name": "NHL 2005",
        "summary": "Capture all the speed, finesse, and action of professional hockey with NHL 2005, the successor to NHL 2004. The game's new EA Sports Open Ice Control lets you execute offensive plays, such as a give-and-go and a breakaway pass, and you can also call for defensive double-teams. Dynasty mode has been enhanced with more interactive GM/owner relationships, including a new e-mail system. NHL 2005 also delivers all the action of the World Cup of Hockey with International Teams and venues from North America and Europe.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co2got.jpg",
        "release_date": 1095120000,
        "rating": 87.93859166687233,
        "rating_count": 17,
        "genres": "Simulator|Sport",
        "platform_ids": "11,21,6,8",
        "external_url": "https://www.igdb.com/games/nhl-2005",
        "cached_at": 1772208565
      },
      {
        "id": 24869,
        "name": "Resident Evil",
        "summary": "Resident Evil is the 2002 remake of the original 1996 video game of the same name featuring various improvements and gameplay overhaul. The game features all-new graphics and sound, and also incorporates gameplay elements from the earlier installments. While the overall plot remained mostly unchanged, several new areas and rooms were added to the game. This remake also features many additional modes, secrets and various endings over the original.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co2vz8.jpg",
        "release_date": 1016755200,
        "rating": 87.82425948484226,
        "rating_count": 248,
        "genres": "Puzzle|Adventure",
        "platform_ids": "21",
        "external_url": "https://www.igdb.com/games/resident-evil--1",
        "cached_at": 1772208565
      },
      {
        "id": 2240,
        "name": "Pikmin 2",
        "summary": "In Pikmin 2, Captain Olimar returns to the planet he was originally stranded on, to collect trinkets for his failing company to sell back at home. The game features a 2-character mechanic, which allows players to switch between two spacemen while collecting items. Two-player co-op challenge missions and a competitive mode are also available.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co5y6q.jpg",
        "release_date": 1083196800,
        "rating": 87.5983972327738,
