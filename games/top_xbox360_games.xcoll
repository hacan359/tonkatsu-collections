      {
        "id": 21892,
        "name": "Fallout 3: Game of the Year Edition",
        "summary": "Prepare for the Future with Fallout 3: Game of the Year Edition, experience the most acclaimed game of 2008 like never before. Create a character of your choosing and descend into an awe-inspiring, post-apocalyptic world where every minute is a fight for survival.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co1yc1.jpg",
        "release_date": 1255392000,
        "rating": 89.5065554210646,
