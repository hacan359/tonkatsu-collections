      {
        "id": 21988,
        "name": "Dark Souls: Artorias of the Abyss",
        "summary": "Artorias of the Abyss is additional content for the game Dark Souls. It was originally released for PC as part of the Dark Souls: Prepare to Die Edition, and later for consoles as the eponymous DLC. A console version of the Prepare To Die Edition was also released at a later date.",
        "cover_url": "https://images.igdb.com/igdb/image/upload/t_cover_big/co95nf.jpg",
